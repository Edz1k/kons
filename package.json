{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @brillex/web build",
    "build:sklad": "pnpm --filter @brillex/sklad build",
    "dev:web": "pnpm --filter @brillex/web dev",
    "dev:sklad": "pnpm --filter @brillex/sklad dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "pnpm -r --if-present test:unit",
    "typecheck": "pnpm -r typecheck",
    "up": "taze major -I -r",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-cypress": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "lint-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "resolutions": {
    "unplugin": "catalog:build",
    "vite": "catalog:build",
    "vite-plugin-inspect": "catalog:build"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
